      "type": "alertlist",
      "title": "지금 울리는 경보 (Grafana·Prometheus 규칙)",
      "description": "울리는 중·pending·오류 상태의 경보(severity none인 Watchdog 제외). 펼치면 라벨, 누르면 규칙 화면",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 9,
        "h": 10
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "maxItems": 50,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "{severity!=\"none\"}",
        "folder": null,
        "datasource": "",
        "showInactiveAlerts": false,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "recovering": true,
          "noData": true,
          "normal": false,
          "error": true
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Prometheus 경보 라벨 (울리는 중·pending)",
      "description": "Prometheus 규칙 경보의 라벨. namespace·service·pod로 어디서 울리는지 확인",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 9,
        "w": 15,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertname!~\"Watchdog|InfoInhibitor\"}",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "prometheus": true,
              "uid": true
            },
            "indexByName": {
              "alertname": 0,
              "alertstate": 1,
              "severity": 2,
              "namespace": 3,
              "service": 4,
              "pod": 5
            },
            "renameByName": {
              "alertname": "경보",
              "alertstate": "상태",
              "severity": "severity"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 90
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "경보"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 240
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "severity",
            "desc": false
          }
        ]
      }
    },
