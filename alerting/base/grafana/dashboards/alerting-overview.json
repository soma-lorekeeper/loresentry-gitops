      "type": "timeseries",
      "title": "Slack 전송",
      "description": "구간마다 Alertmanager가 Slack에 보낸 수와 실패한 수(새 메시지와 메시지 수정 모두)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(alertmanager_notifications_total{integration=\"slack\"}[$__rate_interval]))",
          "legendFormat": "전송",
          "refId": "A",
