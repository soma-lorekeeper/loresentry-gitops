{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AlbAccessLogs",
      "Effect": "Allow",
      "Principal": { "Service": "logdelivery.elasticloadbalancing.amazonaws.com" },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::__BUCKET__/alb/AWSLogs/__ACCOUNT__/*"
    },
    {
      "Sid": "CloudFrontLogDeliveryAclCheck",
      "Effect": "Allow",
      "Principal": { "Service": "delivery.logs.amazonaws.com" },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "__ACCOUNT__" },
        "ArnLike": { "aws:SourceArn": "arn:aws:logs:us-east-1:__ACCOUNT__:delivery-source:*" }
      }
    },
    {
      "Sid": "CloudFrontLogDeliveryWrite",
      "Effect": "Allow",
      "Principal": { "Service": "delivery.logs.amazonaws.com" },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::__BUCKET__/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceAccount": "__ACCOUNT__"
        },
        "ArnLike": { "aws:SourceArn": "arn:aws:logs:us-east-1:__ACCOUNT__:delivery-source:*" }
      }
    }
  ]
}
