{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArchiveWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectAcl", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::__BUCKET__/*"
    },
    {
      "Sid": "ArchiveBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketMultipartUploads", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::__BUCKET__"
    }
  ]
}
