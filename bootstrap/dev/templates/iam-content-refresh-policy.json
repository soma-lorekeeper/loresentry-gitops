{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RefreshInputs",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::__BUCKET__/refresh/*"
    },
    {
      "Sid": "HeadObjectNotFound",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": { "StringLike": { "s3:prefix": "refresh/*" } }
    }
  ]
}
