{
  "_meta": {
    "description": "loresentry additions to the built-in logs-*-* template. Rules: docs repository LOG_SCHEMA.md, logging/README.md",
    "managed_by": "loresentry-gitops"
  },
  "template": {
    "settings": {
      "index": {
        "number_of_replicas": "0",
        "lifecycle": {
          "prefer_ilm": false
        },
        "mapping": {
          "total_fields": {
            "limit": 2000,
            "ignore_dynamic_beyond_limit": true
          }
        }
      }
    },
    "lifecycle": {
      "data_retention": "30d"
    },
    "mappings": {
      "dynamic_templates": [
        {
          "loresentry_strings_as_keyword": {
            "path_match": "loresentry.*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ],
      "properties": {
        "log": {
          "properties": {
            "logger": { "type": "keyword" }
          }
        },
        "service": {
          "properties": {
            "name": { "type": "keyword" },
            "version": { "type": "keyword" }
          }
        },
        "http": {
          "properties": {
            "request": {
              "properties": {
                "id": { "type": "keyword" },
                "method": { "type": "keyword" }
              }
            },
            "response": {
              "properties": {
                "status_code": { "type": "long" }
              }
            }
          }
        },
        "event": {
          "properties": {
            "duration": { "type": "long" }
          }
        },
        "error": {
          "properties": {
            "code": { "type": "keyword" },
            "type": { "type": "keyword" }
          }
        },
        "user": {
          "properties": {
            "id": { "type": "keyword" }
          }
        },
        "orchestrator": {
          "properties": {
            "type": { "type": "keyword" }
          }
        },
        "postgresql": {
          "properties": {
            "log": {
              "properties": {
                "user": { "type": "keyword" },
                "database": { "type": "keyword" },
                "session_id": { "type": "keyword" }
              }
            }
          }
        },
        "tags": { "type": "keyword" },
        "loresentry": {
          "properties": {
            "project_id": { "type": "keyword" },
            "document_id": { "type": "keyword" },
            "file_id": { "type": "keyword" },
            "chat": {
              "properties": {
                "session_id": { "type": "keyword" },
                "turn_id": { "type": "keyword" }
              }
            },
            "refresh": {
              "properties": {
                "request_id": { "type": "keyword" },
                "run_id": { "type": "keyword" }
              }
            },
            "setting_check": {
              "properties": {
                "run_id": { "type": "keyword" }
              }
            },
            "kafka": {
              "properties": {
                "topic": { "type": "keyword" },
                "partition": { "type": "long" },
                "offset": { "type": "long" },
                "key": { "type": "keyword" }
              }
            },
            "cloudevent": {
              "properties": {
                "id": { "type": "keyword" },
                "type": { "type": "keyword" },
                "subject": { "type": "keyword" }
              }
            }
          }
        }
      }
    }
  }
}
